# STATE.a2ml — project state checkpoint for ZeroInflatedCounts.jl.

[metadata]
project = "ZeroInflatedCounts.jl"
version = "0.1.0"
last-updated = "2026-10-02"
# AUTHORITY: when this and CLADE [status] phase disagree, CLADE phase is the
# authoritative SCM checkpoint and STATE must be re-derived from it.
status = "active"

[project-context]
name = "ZeroInflatedCounts.jl"
purpose = "Hurdle and zero-inflated negative binomial models for sequencing count data: R pscl in production, a Julia likelihood oracle in tests, and Agda proofs of the model identities."
completion-percentage = 5

[position]
phase = "design"           # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "Method-conditions specification (docs/method-conditions/zero-inflation-and-hurdle.adoc)", completion = 100 },
  { name = "hurdle_nb and zinb via R pscl, with a test-only Julia likelihood oracle", completion = 0 },
  { name = "Known-answer, reference and negative-control tests", completion = 0 },
  { name = "Agda proofs: hurdle separability, truncation normaliser, ZINB zero probability", completion = 0 },
  { name = "Adapter PR into MetaManifold-WebUI", completion = 0 },
]

[blockers-and-issues]
# The consumer's method catalogue v1 approves no NB model for sequencing data;
# an owner-approved amendment is needed before these methods count as approved.
# The NB GLM they extend (MetaManifold-WebUI#102) must land first.

[critical-next-actions]
actions = [
  "Owner approves the method-catalogue amendment for NB, hurdle NB and ZINB",
  "Implement hurdle_nb and zinb against the conditions document",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = []
depends-on = []
